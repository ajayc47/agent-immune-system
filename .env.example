# Leave unset to run fully offline (embedded ClickHouse + deterministic stubs).

# ClickHouse Cloud (real-time analytics). When set, used instead of embedded chDB.
CLICKHOUSE_HOST=your-service.clickhouse.cloud
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=default

# AkashML (OpenAI-compatible) for attack mutation + incident summaries.
AKASHML_API_KEY=
AKASHML_BASE_URL=https://api.akashml.com/v1
AKASHML_MODEL=deepseek-ai/DeepSeek-V3.1
